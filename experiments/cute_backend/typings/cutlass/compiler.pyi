"""Consumed bindings from nvidia-cutlass-dsl 4.7.1 (native pybind11 ABI).

NVIDIA's compiler module re-exports an extension without Python stubs.
Keep this surface narrow and verify it with the artifact integration test.
"""

from enum import Enum

class Abi(Enum):
    Tbd = ...

class ArtifactType(Enum):
    PreCompiledMlir = ...
    Object = ...

class CompilationArtifact: ...

class PreCompiledMlirArtifact(CompilationArtifact):
    @staticmethod
    def from_textual_form(data: bytes) -> PreCompiledMlirArtifact: ...

class CuteCompiler:
    def __init__(self) -> None: ...
    def set_device_target(self, arch: str) -> None: ...
    def set_abi(self, abi: Abi) -> None: ...
    def set_pipeline(self, artifact_type: ArtifactType, pipeline: str) -> None: ...
    def compile_to(
        self, artifacts: CompilationArtifact, target: ArtifactType
    ) -> CompilationArtifact: ...
